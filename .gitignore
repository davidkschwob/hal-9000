# ==========================================
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ==========================================
# Environment Variables & Secrets (NEVER commit these)
# ==========================================
.env
.env.local
.env.*
.secrets

